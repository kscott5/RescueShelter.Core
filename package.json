{
  "name": "rescueshelter.core",
  "version": "2.1.13",
  "description": "Rescue Shelter Common Reports and Services functionality ",
  "main": "index.js",
  "repository": "https://github.com/kscott5/RescueShelter.Core",
  "author": "Karega K. Scott <kkscott@outlook.com>",
  "license": "LGPL-3.0-or-later",
  "private": false,
  "type": "commonjs",
  "dependencies": {
    "body-parser": "^2.4.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "helmet": "3.23.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "path": "0.12.7",
    "winston": "3.3.3",
    "winston-daily-rotate-file": "4.5.0"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.1",
    "@types/helmet": "0.0.47",
    "@types/morgan": "1.9.1",
    "@types/node": "22.14.1",
    "typescript": "5.8.2"
  },
  "scripts": {
    "esbuild": "npm run clean && npx --yes esbuild --bundle src/index.ts --outdir=./dist --platform=node --target=esnext",
    "tsbuild": "npm run clean && npx --yes tsc -p tsconfig.json",
	"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.test.json",
	"test": "npm run build && node --test ./dist"
  },
  "files": [
    "README.MD",
    "package.json",
    "./public/**",
    "./dist/**"
  ]
}
